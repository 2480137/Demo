<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Bitcoin Rate Printer Suite" verbose="2">

    <!-- Scenario 3: USD -->
    <test name="Bitcoin USD Rate Test">
        <classes>
            <class name="com.bitcoin.tests.BitcoinUSDRateTest">
                <methods>
                    <include name="printUSDRate"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Scenario 4: GBP -->
    <test name="Bitcoin GBP Rate Test">
        <classes>
            <class name="com.bitcoin.tests.BitcoinGBPRateTest">
                <methods>
                    <include name="printGBPRate"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Scenario 5: EUR -->
    <test name="Bitcoin EUR Rate Test">
        <classes>
            <class name="com.bitcoin.tests.BitcoinEURRateTest">
                <methods>
                    <include name="printEURRate"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>
