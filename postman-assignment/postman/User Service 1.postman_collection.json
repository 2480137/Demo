  "item": [
    {
      "name": "View All Users",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.test(\"check status code\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"checkphonenumber\", function () {\r",
              "    const users = pm.response.json();\r",
              "    // Validate phone number exists and is a string for every user\r",
              "    users.forEach(function (user) {\r",
              "        pm.expect(user).to.have.property('phone');\r",
              "        pm.expect(user.phone).to.be.a('string');\r",
              "        pm.expect(user.phone).to.not.be.empty;\r",
              "    });\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
